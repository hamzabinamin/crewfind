{
  "expo": {
    "name": "CrewFind",
    "slug": "crewfind",
    "displayName": "CrewFind",
    "version": "1.0.13",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/images/icon-new.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.fulltrade.crewfind",
      "displayName": "CrewFind",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby specials and offers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-new.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.fulltrade.crewfind",
      "displayName": "CrewFind",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/40.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-dev-client"
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3141b742-d0db-4b62-b493-eae94802fcda"
      }
    },
    "owner": "hamzabinamin"
  }
}
