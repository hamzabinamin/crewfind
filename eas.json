{
  "cli": {
    "version": ">= 16.3.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-14-xcode-16"
      },
      "env": {
        "EAS_LOCAL_BUILD_SKIP_CLEANUP": "1",
        "EXPO_NO_DOCTOR": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_LOCAL_BUILD_SKIP_CLEANUP": "1",
        "EXPO_NO_DOCTOR": "1"
      }
    },
    "iospreview": {
      "ios": {
        "simulator": true
      }
    },
    "androidpreview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}